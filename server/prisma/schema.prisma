generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

enum ProductCategory {
  HOODIE
  TSHIRT
  LONGSLEEVE
  CAP
}

enum ProductColor {
  BLACK
  WHITE
  GREY
}

enum ProductSize {
  XS
  S
  M
  L
  XL
}

model Product {
  id          String           @id @default(uuid())
  sku         String           @unique
  name        String
  slug        String           @unique
  description String
  price       Decimal
  category    ProductCategory
  mainImage   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  images      ProductImage[]
  variants    ProductVariant[]
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  alt       String
  order     Int
  product   Product @relation(fields: [productId], references: [id])

  @@unique([productId, order])
}

model ProductVariant {
  id        String       @id @default(uuid())
  productId String
  color     ProductColor
  size      ProductSize
  stock     Int

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, color, size])
}

model Order {
  id              String      @id @default(uuid())
  customerName    String
  customerEmail   String
  customerPhone   String
  customerAddress String
  totalPrice      Decimal
  status          OrderStatus @default(PENDING)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
}

model OrderItem {
  id                   String       @id @default(uuid())
  orderId              String
  productIdSnapshot    String
  productNameSnapshot  String
  productColorSnapshot ProductColor
  productSizeSnapshot  ProductSize
  productPriceSnapshot Decimal
  quantity             Int
  note                 String?
  totalPrice           Decimal
  order                Order        @relation(fields: [orderId], references: [id])
}

model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
