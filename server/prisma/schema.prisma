generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

model Product {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String
  price       Decimal
  category    String
  mainImage   String
  stock       Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  images      ProductImage[]
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  alt       String
  order     Int
  product   Product @relation(fields: [productId], references: [id])
}

model Order {
  id              String      @id @default(uuid())
  customerName    String
  customerEmail   String
  customerPhone   String
  customerAddress String
  totalPrice      Decimal
  status          OrderStatus @default(PENDING)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
}

model OrderItem {
  id                   String  @id @default(uuid())
  orderId              String
  productIdSnapshot    String
  productNameSnapshot  String
  productPriceSnapshot Decimal
  quantity             Int
  note                 String?
  totalPrice           Decimal
  order                Order   @relation(fields: [orderId], references: [id])
}
