generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Product {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String
  price       Decimal
  category    String
  mainImage   String
  stock       Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  images      ProductImage[]
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  alt       String
  order     Int
  product   Product @relation(fields: [productId], references: [id])
}
